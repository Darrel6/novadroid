{
  "name": "novadroid",
  "version": "0.1.0",
  "description": "NovaDroid - lanceur de jeux Android pour PC basé sur l'émulateur Android open source",
  "main": "dist/main/main.js",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "doctor": "npm run build && node dist/cli/doctor.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0"
  }
}
